# Copy to .env for local runs. In GitHub Actions, add these as repository secrets
# (Settings → Secrets and variables → Actions). All are optional.

# Email the Excel report (Gmail → use an App Password, not your normal password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# Telegram alert with the day's setups
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
